<bpmn:outgoing>f_s7_s8</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="s8" name="Apparaat terugsturen">
<bpmn:incoming>f_s7_s8</bpmn:incoming>
<bpmn:outgoing>f_s8_s9</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="s9" name="Oorzaak niet vastgelegd">
<bpmn:incoming>f_s8_s9</bpmn:incoming>
</bpmn:endEvent>
